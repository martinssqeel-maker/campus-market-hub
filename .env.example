# ---------------------------------------------------------------------------
# Campus Marketplace – environment template
#
# Copy this file to `.env` for local development, or paste these same four
# names into the Vercel project's Environment Variables (Project → Settings →
# Environment Variables) before deploying. Full walkthrough: docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------

# development | testing | production      ("production" on Vercel)
FLASK_ENV=development

# Leave empty locally to use the SQLite file at backend/database.db.
# On Vercel this is the managed PostgreSQL connection string:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# Signs Flask sessions – use a long random string (openssl rand -hex 32).
SECRET_KEY=replace-me-with-a-long-random-secret

# Signs login (JWT) tokens – a different long random string.
JWT_SECRET=replace-me-with-a-different-long-random-secret

# ---------------------------------------------------------------------------
# Hosted image storage is configured with UPLOAD_STORAGE=s3 plus the S3_*
# variables (Cloudflare R2, AWS S3, MinIO…). They are documented in
# docs/DEPLOYMENT.md and – for local development – in backend/.env.example.
# ---------------------------------------------------------------------------
