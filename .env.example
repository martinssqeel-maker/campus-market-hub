# Copy to .env before running; replace all sample secrets and admin credentials.
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=30
ADMIN_NAME=Campus Marketplace Admin
ADMIN_EMAIL=admin@fulafia.edu.ng
ADMIN_PASSWORD=replace-this-before-deployment
ADMIN_PHONE=08030000000
# SQLite is used by default. Production example:
# DATABASE_URL=mysql+pymysql://campus_user:strong-password@127.0.0.1/campus_market?charset=utf8mb4
# CORS_ORIGINS=https://your-frontend.example
# UPLOAD_FOLDER=/absolute/path/to/persistent/uploads
# AUTO_PUBLISH=false
