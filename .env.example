# Copy to .env before running. Replace both secrets with long random values.
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret
JWT_ACCESS_TOKEN_HOURS=12
# SQLite is used by default. Production example:
# DATABASE_URL=mysql+pymysql://campus_user:strong-password@127.0.0.1/campus_marketplace?charset=utf8mb4
# CORS_ORIGINS=https://your-frontend.example
# UPLOAD_FOLDER=/absolute/path/to/persistent/uploads
# FLASK_DEBUG=0
