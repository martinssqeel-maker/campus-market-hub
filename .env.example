# Campus Marketplace – production environment (Vercel).
# On Vercel, set these in the project dashboard (Settings → Environment
# Variables) instead of committing a .env file.  Locally you may copy this
# to .env; see docs/DEPLOYMENT_VERCEL.md for where each value comes from.
FLASK_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/campus_market?sslmode=require
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-a-different-long-random-string
