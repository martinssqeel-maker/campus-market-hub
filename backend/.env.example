# Campus Marketplace – local development environment.
# Copy to .env before running; replace all sample secrets.
# (For the Vercel/production variable set see the root .env.example and
#  docs/DEPLOYMENT_VERCEL.md.)
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_HOURS=24
JWT_REFRESH_DAYS=30
# SQLite is used by default. Production examples:
# DATABASE_URL=postgresql://campus_user:strong-password@127.0.0.1:5432/campus_market
# DATABASE_URL=mysql+pymysql://campus_user:strong-password@127.0.0.1/campus_market?charset=utf8mb4
# CORS_ORIGINS=https://your-frontend.example
# UPLOAD_FOLDER=/absolute/path/to/persistent/uploads
# AUTO_PUBLISH=false
#
# Image storage: "local" (default) writes to frontend/assets/uploads.
# Use "s3" for persistent storage on any serverless host (Vercel, …).
# UPLOAD_STORAGE=local
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # R2 (AWS S3: leave unset)
# S3_BUCKET=campus-market-uploads
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION=auto                                                 # R2 (AWS: e.g. us-east-1)
# S3_PUBLIC_URL=https://pub-<bucket-id>.r2.dev                   # public read URL
# S3_KEY_PREFIX=uploads
