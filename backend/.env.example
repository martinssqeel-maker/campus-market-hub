# ---------------------------------------------------------------------------
# Campus Marketplace – local development environment template
#
# Copy this file to `backend/.env` and adjust the values you need; every one
# has a working default, so the app also runs with no .env file at all.
#
# Hosted deployments use the four variables in the repository-root
# `.env.example` plus UPLOAD_STORAGE / S3_* – see docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# --- Flask -----------------------------------------------------------------
FLASK_ENV=development                 # development | testing | production
SECRET_KEY=change-me-to-a-random-string
HOST=0.0.0.0
PORT=5000

# --- Database --------------------------------------------------------------
# Development (default): a SQLite file next to app.py
# DATABASE_URL=sqlite:///database.db
#
# Production PostgreSQL (psycopg 3 ships in requirements.txt):
# DATABASE_URL=postgresql://campus_user:StrongPass@localhost/campus_market
#
# Production MySQL (PyMySQL ships in requirements.txt):
# DATABASE_URL=mysql+pymysql://campus_user:StrongPass@localhost/campus_market

# --- JWT -------------------------------------------------------------------
JWT_SECRET=change-me-too-another-random-string    # JWT_SECRET_KEY also works
JWT_ACCESS_HOURS=24                   # access token lifetime
JWT_REFRESH_DAYS=30                   # refresh token lifetime

# --- Administrator ---------------------------------------------------------
# Administrators are only created by `flask --app app create-admin`, which
# reads these variables when the matching options are not passed. Nothing is
# created automatically – no demo accounts, no default password.
# ADMIN_NAME=Campus Marketplace Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-before-any-real-deployment
# ADMIN_PHONE=08030000000

# --- Uploads ---------------------------------------------------------------
# local (default) = save to UPLOAD_FOLDER; s3 = S3-compatible bucket
UPLOAD_STORAGE=local
# UPLOAD_FOLDER=/absolute/path/to/frontend/assets/uploads
# MAX_UPLOAD_MB=5

# Object storage – used when UPLOAD_STORAGE=s3. On Vercel, set these in the
# dashboard instead of a file (see docs/DEPLOYMENT.md).
# S3_BUCKET=campus-market
# S3_REGION=auto
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_PREFIX=uploads
# S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
# S3_ADDRESSING_STYLE=path

# --- Moderation ------------------------------------------------------------
# false = every listing waits for admin approval (recommended / default)
# true  = listings publish immediately (useful for a quick demo)
AUTO_PUBLISH=false

# --- CORS ------------------------------------------------------------------
# "*" during development. In production list your exact frontend origin(s):
# CORS_ORIGINS=https://campus-market.example.com
